rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /shops/{shopId} {
      // 公開VRストア画面(/)は誰でも閲覧できる
      allow read: if true;
      // 書き込みは自分の店舗(uid==shopId)のオーナーのみ
      allow write: if request.auth != null && request.auth.uid == shopId;

      match /objects/{objectId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == shopId;
      }

      match /placements/{placementId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == shopId;
      }
    }
  }
}
